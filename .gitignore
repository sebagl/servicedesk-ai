# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Telnyx Edge local dev/runtime artifacts (written by `telnyx-edge dev`)
.telnyx/

# Build output
dist/
*.tsbuildinfo

# Logs
*.log
*.log.*

# OpenCode — track config files, ignore dependencies and package artifacts
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.opencode/.gitignore
