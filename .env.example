# servicedesk-ai — placeholders only. Copy to .env for local CLI use; never commit .env.
# The deployed function reads these from Edge secrets (telnyx-edge secrets add), not from this file.

TELNYX_API_KEY=your-telnyx-api-key          # CLI auth / provisioning
MCP_API_TOKEN=random-value                  # bearer for /mcp (also an integration secret in the assistant)
PORTAL_API_TOKEN=random-value               # bearer for /portal API (/api/*)
SMOKE_TEST_TOKEN=random-value               # bearer for /demo/* smoke routes
TELNYX_PUBLIC_KEY=account-public-key-base64 # verifies webhook signatures
CALL_PAGE_PASSWORD=random-value             # HTTP Basic password for /call (share by email)
TELNYX_ASSISTANT_ID=assistant-xxxx          # assistant embedded by the /call widget
